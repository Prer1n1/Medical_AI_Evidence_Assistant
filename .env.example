# Copy this file to .env and fill in your real keys. .env is gitignored —
# never commit real secrets.

# Required — used for synthesis, planning/routing, category + evidence-level
# classification, and (optionally) image captioning. Embeddings do NOT use
# this key — see EMBEDDING_MODEL below, embeddings run locally.
OPENAI_API_KEY=sk-your-key-here

# Local biomedical embedding model (sentence-transformers, runs on CPU, no
# API key/cost). PubMedBERT-based, fine-tuned for retrieval — see
# storage/vector_store.py and docs/design-decisions.md for why this was
# chosen over OpenAI embeddings.
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO

# Required — the API layer (api/app.py) refuses every request without a
# matching X-API-Key header (except /health). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Required by NCBI's E-utilities usage policy for the PubMed connector
# (ingestion/connectors/pubmed.py) — identifies the caller, not a secret.
# See https://www.ncbi.nlm.nih.gov/books/NBK25497/
NCBI_EMAIL=your-email@example.com

# Optional — a free NCBI API key raises the E-utilities rate limit from
# 3 req/sec to 10 req/sec. Get one at ncbi.nlm.nih.gov/account/settings.
# Leave unset to use the (still functional) unauthenticated rate limit.
NCBI_API_KEY=

# Optional — Cohere Rerank, reranks retrieval candidates for precision
# (see retrieval/reranker.py). Free trial key at dashboard.cohere.com.
# Leave unset to skip reranking (retrieval falls back to plain RRF order).
COHERE_API_KEY=

# Optional — controls the API server's structured (JSON) log verbosity.
# Defaults to INFO. Does not affect main.py's CLI output.
LOG_LEVEL=INFO

# Optional — get a free key at smith.langchain.com. Tracing turns on
# automatically the moment LANGSMITH_API_KEY is set; leave unset to skip it.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-ai-evidence-assistant
